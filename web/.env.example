# Which chain the server indexes: "mstTestnet" (default) or "localhost".
RELEASEBOND_CHAIN=mstTestnet
# Optional RPC override (defaults to https://testnetrpc.mstblockchain.com for MST Testnet).
# RELEASEBOND_RPC_URL=

# ReleaseBond contract. Leave empty to deploy from a Bridgekey wallet on /admin
# (the address is then stored in the local database) or to use
# ../contracts/deployments/<chain>.json written by the Hardhat deploy script.
# RELEASEBOND_CONTRACT_ADDRESS=
# Block the contract was deployed in; set it with the address so the indexer
# does not scan the chain from genesis.
# RELEASEBOND_DEPLOY_BLOCK=

# Where SQLite, artifacts and uploads live (default ./data).
# RELEASEBOND_DATA_DIR=

# Session cookie signing key (random per data dir if unset).
# SESSION_SECRET=

# Evidence engine
# Set to "docker" to run npm install scripts in a no-network Docker sandbox.
RELEASEBOND_SANDBOX=docker
# Number of fresh sandbox runs per reproduction (default 3).
# RELEASEBOND_DYNAMIC_RUNS=3
# Enables the Claude-backed analysis agent; without it a heuristic analyst is used.
# ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-sonnet-5

# Serve cookies without the Secure flag when running `next start` over plain http.
# RELEASEBOND_INSECURE_COOKIES=1

# Abuse limits (write endpoints). "off" disables; SCALE multiplies every budget.
# RELEASEBOND_RATE_LIMIT=on
# RELEASEBOND_RATE_LIMIT_SCALE=1
# Only behind a reverse proxy you control: limit per client IP from X-Forwarded-For.
# Without it, unauthenticated sign-in requests share one global bucket.
# RELEASEBOND_TRUST_PROXY=1
# Per-wallet cap on uploaded proof files (bytes, default 200 MB).
# RELEASEBOND_UPLOAD_QUOTA_BYTES=209715200
# Concurrent background evidence runs (default 2).
# RELEASEBOND_EVIDENCE_CONCURRENCY=2
